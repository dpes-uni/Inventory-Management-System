# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/inventory_management

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=1d

# Server
PORT=5000
NODE_ENV=production

# CORS
# FRONTEND_URL is the primary variable for production (Vercel URL).
# CORS_ORIGIN is kept as a fallback for local development.
FRONTEND_URL=https://your-vercel-app.vercel.app
# CORS_ORIGIN=http://localhost:5173